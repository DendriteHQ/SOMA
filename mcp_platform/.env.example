APP_NAME=your-platform-api
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_MAX_BYTES=104857600
LOG_FILE_BACKUP_COUNT=5
DEBUG_CLEAR_DB=false

# Postgres
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/appdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
RDS_SECRET_ID=
RDS_WRITER_HOST=
RDS_READER_HOST=
RDS_PORT=5432
RDS_DB_NAME=
RDS_USE_READER=false

# S3
S3_BUCKET=s114-miners-solutions

# Bittensor / Metagraph
BT_NETUID=114
BT_NETWORK=
BT_CHAIN_ENDPOINT=
BT_METAGRAPH_EPOCH_LENGTH=100
BT_METAGRAPH_SYNC_SECS=60

# Weight Setting
MAX_MINERS_FOR_WEIGHTS=1
TOP_SCREENER_SCRIPTS=0.2
PREVIOUS_COMPETITION_SCREENERS_GRACE_HOURS=4
PARTIAL_WINNERS_WEIGHT_FRACTION=0.05
SCREENER_EXTRA_MINERS_LIMIT=10
SCREENER_EXTRA_SCORE_POINTS=0.03

# Cooldown for blocking validators from new assignments after OpenRouter scoring errors (seconds)
VALIDATOR_OPENROUTER_ERROR_COOLDOWN_SECONDS=600

# Validator minimum stake weights
# total weight = alpha_stake + tao_stake * tao_weight
MIN_VALIDATOR_TOTAL_WEIGHT=30000
MIN_VALIDATOR_ALPHA_WEIGHT=5000

# QA Generator
QA_GENERATOR_MODEL=
OPENROUTER_API_KEY=

# Remote Sandbox Service Configuration (Required)
# URL of the remote sandbox service running on separate machine
SANDBOX_SERVICE_URL=http://sandbox-host:8001

# Sandbox Timeout Configuration
# Maximum execution time forwarded to one sandbox task (seconds)
SANDBOX_TIMEOUT_PER_TASK_SECONDS=10.0
# Timeout for waiting on sandbox task acceptance response (seconds)
SANDBOX_SUBMISSION_TIMEOUT_SECONDS=10.0

# SWE-Bench Orchestration
SWEBENCH_BENCHMARK_NAME=SWE-bench/SWE-bench_Verified
SWEBENCH_DEFAULT_MODEL=deepseek/deepseek-v4-pro
GATEWAY_FORCE_PROVIDER=deepseek
SWEBENCH_ORCHESTRATOR_INTERVAL_SECONDS=2.0
SWEBENCH_DISPATCH_BATCH_SIZE=8
SWEBENCH_DISPATCH_STRICT_FIFO=false
# Rate limit dispatches in a rolling window (set max runs to 0 to disable)
SWEBENCH_DISPATCH_WINDOW_SECONDS=60
SWEBENCH_DISPATCH_MAX_RUNS_PER_WINDOW=10
# Per-miner cap for in-flight dispatched runs (set to 0 to disable)
SWEBENCH_MAX_CONCURRENT_DISPATCHED_PER_MINER=30
SWEBENCH_RETRY_BASE_SECONDS=5.0
SWEBENCH_RETRY_MAX_SECONDS=120.0
SWEBENCH_RETRY_JITTER_SECONDS=2.0
SWEBENCH_VALIDATION_CLAIM_TTL_SECONDS=900
SWEBENCH_SCREENING_MIN_PASSED_TASKS=0
SWEBENCH_SCREENING_PASS_RATIO=0.5
SWEBENCH_SCREENING_MIN_WEIGHTED_TOKEN_SAVING_RATIO=0.1
SWEBENCH_SCREENING_INPUT_TOKENS_WEIGHT=1.0
SWEBENCH_SCREENING_CACHED_INPUT_TOKENS_WEIGHT=0.3333333333333333
SWEBENCH_SCREENING_OUTPUT_TOKENS_WEIGHT=3.0

## Benchmarks per screener stage
# The dataset a task's runs are dispatched against comes from
# swe_bench_tasks.benchmark_name. These two settings are only the fallback used when
# that column is empty: stage 1 screens on public SWE-bench Verified, while stage 2 and
# full evaluation run SOMA's own task lists (whose rows ship their own env/test images).
SWEBENCH_SCREENER1_BENCHMARK_NAME=SWE-bench/SWE-bench_Verified
SOMA_TASKS_BENCHMARK_NAME=soma-is-tasks

## Hidden-task image repository visibility
# Validators grade a SOMA task by pulling its test image. Those images live in a
# private Docker Hub repository so a competition's hidden tasks are not published in
# advance; rather than distributing registry credentials to every validator, the
# platform flips that repository public for the evaluation window and private again
# afterwards. Requires DOCKERHUB_USERNAME / DOCKERHUB_TOKEN (set above).
DOCKERHUB_VISIBILITY_ENABLED=true
# JSON array of "<namespace>/<repo>" (pydantic-settings JSON-decodes this field, so a
# bare or comma-separated string is rejected).
DOCKERHUB_TASK_REPOSITORIES=["dendritexhq/soma-competition-tasks-dind"]
# Screener stage 2 and full evaluation both run inside the evaluation window (stage 2
# begins at eval_starts_at, not at upload_ends_at), so the default already covers every
# hidden-task run. upload_ends_at only opens earlier, during the idle stretch before
# stage 2 - it grades nothing extra and only lengthens the exposure window. The boundary
# itself needs no help from it: the loop wakes on the window edge rather than on the
# interval, and dispatch is held back until the repository is observed public.
DOCKERHUB_VISIBILITY_PUBLIC_FROM=eval_starts_at
DOCKERHUB_VISIBILITY_INTERVAL_SECONDS=300

## Hidden-task image repository contents
# The repository the platform publishes is derived from swe_bench_tasks: each tick it
# copies the images of the SOMA tasks the current competitions reference out of the
# long-lived source repository, and deletes everything else. The source repository
# accumulates every task ever built and can never be published, which is why the
# published one is a per-competition subset rather than the source itself.
#
# Deletions only ever run while the repository is private, so a prune cannot happen
# while a validator is pulling. In practice that means the repository is emptied
# during the upload window and refilled as tasks are imported. For the same reason a
# public repository only takes copies for competitions whose own window is open: at a
# handover the next competition is already configured, and its hidden images are
# staged on the next private tick rather than added to the published repository.
DOCKERHUB_TASK_SYNC_ENABLED=true
DOCKERHUB_TASK_SOURCE_REPOSITORY=dendritexhq/soma-is-task-dind
# Defaults to the single entry of DOCKERHUB_TASK_REPOSITORIES; set it only when more
# than one repository is under visibility management.
# DOCKERHUB_TASK_TARGET_REPOSITORY=dendritexhq/soma-competition-tasks-dind
# Delete tags no current competition asks for. Turning this off keeps the images of
# past competitions published alongside the current one's.
DOCKERHUB_TASK_SYNC_PRUNE=true
# Hold back a SOMA run until both of its task images are in the repository AND the
# repository has been observed public. Without this the sandbox is asked to pull an env
# image that is not there yet - or that is there but private, which is the state between
# eval_starts_at and the tick that opens the repository - and the run fails for a reason
# the miner had no part in.
DOCKERHUB_TASK_SYNC_BLOCK_DISPATCH=true

## Hidden-task dataset (Hugging Face)
HF_DATASET_ENABLED=false
HUGGINGFACE_TOKEN=hf_xxx
# Must already exist. The platform does not create it: the competition token is scoped
# to an existing repository, and a repository the platform created itself would be one
# nobody reviewed the visibility of.
HF_DATASET_REPOSITORY=soma114/soma-competition-dataset
# Where the rows are read from. swe_bench_tasks records only which tasks a competition
# uses, never their content, so the file supplies the content and the database decides
# which of its rows may be published.
HF_DATASET_SOURCE_FILE=tasks/soma_tasks.jsonl
HF_DATASET_TARGET_PATH=tasks.jsonl
# Drop published rows no current competition asks for. Like the image prune, this only
# ever runs while the repository is private.
HF_DATASET_PRUNE=true
# Collapse the commit history after each content commit. A dataset repository is a git
# repository, so without this the commit listing of a published repository walks back
# through every previous competition's rows.
HF_DATASET_SQUASH_ON_PRUNE=true
# Hold back a SOMA run whose row is not published yet, or whose dataset has not been
# observed public - rows are committed while the repository is still private, so being
# published is not yet the same as being readable. Only turn this on once the sandbox
# and the validator actually read the dataset instead of a local file.
HF_DATASET_BLOCK_DISPATCH=false
