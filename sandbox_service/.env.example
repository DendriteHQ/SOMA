# Environment of the sandbox API container (docker-compose.yml reads it from
# /etc/soma-sandbox/sandbox.env by default). The API forwards the run-related settings
# below to each runner container; it keeps the report URL and callback settings to itself.

# Service Configuration
SANDBOX_SERVICE_HOST=0.0.0.0
SANDBOX_SERVICE_PORT=8001
# Concurrent runs; computed per host by SANDBOX-ANSIBLE's capacity_facts role.
SOMA_SWEBENCH_MAX_CONCURRENT=4

# Platform callback for benchmark reports
COMPACT_BENCH_REPORT_URL=http://sandbox_private_url:port
COMPACT_BENCH_REPORT_TIMEOUT_SECONDS=15

# Images. SANDBOX_IMAGE is set by docker-compose.yml and is also the runner image.
# Tag the other two by build (build_images.sh prints these lines), never `latest`:
# a new tag never replaces an image a run in flight still uses.
COMPACT_BENCH_COMPRESSION_SERVICE_IMAGE=soma-copilot-compression-service:latest
COPILOT_AGENT_IMAGE=local/copilot-cli:latest

# Upstream LLM/OpenAI-compatible base URL (the gateway), reached through each run's own
# proxy container. Include the /v1 prefix.
COMPACT_BENCH_LLM_BASE_URL=

# Callback reliability / retries
COMPACT_BENCH_CALLBACK_RETRY_POLL_SECONDS=1
COMPACT_BENCH_CALLBACK_RETRY_BASE_SECONDS=2
COMPACT_BENCH_CALLBACK_RETRY_MAX_SECONDS=300

# Capacity flood protection
COMPACT_BENCH_CAPACITY_COOLDOWN_SECONDS=2

# Runner supervision
# How often the API checks its runners.
# SANDBOX_SUPERVISOR_POLL_SECONDS=5
# A runner is killed this long after the run's own timeout (agent timeout + grace),
# covering miner download, artifact uploads and result parsing.
# SANDBOX_RUNNER_DEADLINE_MARGIN_SECONDS=600
# Deadline for a run dispatched without a timeout.
# SANDBOX_RUNNER_MAX_SECONDS=14400
# Retry interval for a run whose teardown left resources behind; it keeps its slot.
# SANDBOX_TEARDOWN_RETRY_SECONDS=60
# Runner logs are kept under /var/lib/soma-sandbox/logs for this long.
# SANDBOX_RUNNER_LOG_RETENTION_DAYS=7
# The old age-based dangling-volume sweep: log (report only), delete, or off.
# SANDBOX_LEGACY_VOLUME_SWEEP=log
# Keep each run's work dir after teardown, for debugging by hand.
# COMPACT_BENCH_DEBUG_PRESERVE_OUTPUTS=false

## SOMA task lists
# Screener stage 2 and full evaluation dispatch SOMA's own tasks, whose rows name their
# own pre-built env and test images instead of following SWE-bench's conventions. The
# API materializes those rows into the benchmark row cache at start, so
# `--benchmark <name>` resolves these instances offline in every runner.
#
# The rows are published by the platform to a dataset repository that is private while
# the tasks are hidden and public for the evaluation window, so this host needs no
# credentials and nothing copied onto it. A run for a task this host has not seen
# triggers one re-fetch, so tasks imported after start-up need no restart.
SOMA_TASKS_DATASET_REPO=soma114/soma-competition-dataset
# SOMA_TASKS_DATASET_PATH=tasks.jsonl
# SOMA_TASKS_DATASET_REVISION=main
# Where a successful download is cached, so a later network failure runs from the last
# known-good rows. Defaults to /var/lib/soma-sandbox/tasks/soma_tasks_dataset.jsonl.
# SOMA_TASKS_DATASET_CACHE=/var/lib/soma-sandbox/tasks/soma_tasks_dataset.jsonl
# Minimum gap between refreshes triggered by a run for an unknown task.
# SOMA_TASKS_DATASET_REFRESH_SECONDS=300
# SOMA_TASKS_DATASET_TIMEOUT_SECONDS=60
# Only needed to read the dataset while it is still private, which a host with runs to
# execute never has to do.
# HUGGINGFACE_TOKEN=hf_xxx

# Docker Hub repository holding each task's pre-baked dind env image
# (<repo>:<instance_id>). Pulling it while the repository is private needs
# DOCKERHUB_USERNAME / DOCKERHUB_TOKEN; runners get both through their run's secrets
# file, not their container environment.
SOMA_TASK_DIND_PREBAKED_REPO=dendritexhq/soma-competition-tasks-dind
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
